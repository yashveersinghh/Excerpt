# Prisma Accelerate URL (used by the Worker at runtime via wrangler vars)
DATABASE_URL="prisma://accelerate.prisma-data.net/?api_key=YOUR_ACCELERATE_KEY"

# Direct Postgres URL — required only to run migrations (from Prisma / Neon / Supabase dashboard)
# Do not use the accelerate URL here.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
